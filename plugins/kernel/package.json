  "type": "module",
  "description": "Rho live session plugin: an R and a Python session the Agent and the person run code in, kept with each cell's output, plots and the session's variables",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "exports": {
