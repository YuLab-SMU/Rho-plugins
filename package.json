{
  "name": "@rho-workspace/headless",
  "version": "0.2.0",
  "type": "module",
  "description": "Reusable headless Rho capabilities and optional external Agent entry",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js"
  },
  "bin": {
    "rho-agent-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p headless/tsconfig.json",
    "test": "npm run build && node --test headless/test/*.test.mjs",
    "prepack": "npm run build",
    "test:examples": "node --test examples/real-r-analysis/recipe.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "csv-parse": "7.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3"
  }
}
