{
  "name": "@rho-workspace/plugins-source",
  "version": "0.4.0",
  "type": "module",
  "description": "Reusable headless Rho capabilities and optional external Agent entry",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "node -e \"throw new Error('Pack the selected workspace plugin, not the source repository.')\"",
    "test:examples": "node --test examples/real-r-analysis/recipe.test.mjs",
    "pack:plugins": "node scripts/pack.mjs",
    "test:install": "node scripts/install-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3"
  },
  "private": true,
  "workspaces": [
    "packages/contracts",
    "plugins/documents",
    "plugins/files",
    "plugins/r",
    "plugins/requirements",
    "plugins/tables",
    "plugins/media",
    "plugins/charts",
    "plugins/agent",
    "plugins/annotations"
  ]
}
